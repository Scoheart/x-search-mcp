{
  "name": "@scoheart/x-search-mcp",
  "version": "0.2.0",
  "description": "Independent MCP service for x_search, inspired by Hermes Agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scoheart/x-search-mcp.git"
  },
  "homepage": "https://github.com/Scoheart/x-search-mcp#readme",
  "bugs": {
    "url": "https://github.com/Scoheart/x-search-mcp/issues"
  },
  "keywords": [
    "mcp",
    "x-search",
    "xai",
    "grok",
    "oauth"
  ],
  "type": "module",
  "bin": {
    "x-search-mcp": "./bin/x-search-mcp.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "bin",
    "src",
    "dist",
    "TOOL.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "examples",
    ".env.example",
    "README.md",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "start": "node dist/bin/x-search-mcp.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "proper-lockfile": "4.1.2",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.13.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.8.0"
  },
  "license": "MIT"
}

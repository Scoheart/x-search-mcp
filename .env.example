# xAI API Key (按量计费，优先于 XAI_API_KEY_FILE)
# XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxx

# 私有 API Key 文件路径（如果不想直接在环境变量放置凭证）
# XAI_API_KEY_FILE=/path/to/private/xai-api-key.txt

# 显式指定的 .env 文件路径（默认不扫描其他目录）
# X_SEARCH_ENV_FILE=/path/to/.env

# 认证模式: auto (默认，有 Key 用 Key，无 Key 用 OAuth) | api_key | oauth
X_SEARCH_AUTH_MODE=auto

# 本地 OAuth 凭证文件存放路径（默认 ~/.config/x-search-mcp/auth.json）
# X_SEARCH_AUTH_FILE=/Users/username/.config/x-search-mcp/auth.json

# 公开 OAuth Client ID（默认来自 Hermes 公开客户端）
# XAI_OAUTH_CLIENT_ID=b1a00492-073a-47ea-816f-4c329264a828

# 搜索使用的模型（默认 grok-4.5）
X_SEARCH_MODEL=grok-4.5

# HTTP 超时秒数 (默认 180，范围 5-600)
X_SEARCH_TIMEOUT_SECONDS=180

# 失败重试次数 (默认 2，范围 0-3，仅针对网络、超时及 5xx)
X_SEARCH_RETRIES=2

# 最大轮数 (默认 4，范围 1-20)
X_SEARCH_MAX_TURNS=4

# 思考深度: low | medium | high | xhigh (可选)
# X_SEARCH_REASONING_EFFORT=medium

# 调用日志：保存每次请求体和上游原始响应。默认开启。
# X_SEARCH_LOG=on
# X_SEARCH_LOG_DIR=/Users/username/.config/x-search-mcp/logs
# 保留最近多少份日志，0 表示不清理（默认 100）
# X_SEARCH_LOG_KEEP=100
# 单次原始响应写入上限，超出则截断并标记（默认 8388608，最大 33554432）
# X_SEARCH_LOG_MAX_BYTES=8388608

# 代理支持 (由 Undici EnvHttpProxyAgent 自动读取)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
